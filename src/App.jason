import { useState, useMemo, useCallback, useContext } from 'react';
import './App.css';
import Header from './Header.jsx';
import StudentList from './StudentList.jsx';
import { ThemeContext } from './ThemeContext.jsx';

function App() {
  // 1. students 배열을 상태로 관리하여 새로운 학생 추가가 화면에 실시간 반영되도록 함
  const [students, setStudents] = useState([
    { id: 1, name: '이유림', major: '멀티미디어', score: 85 },
    { id: 2, name: '이성운', major: '컴퓨터공학', score: 92 },
    { id: 3, name: '박예지', major: '멀티미디어', score: 76 },
    { id: 4, name: '이군', major: '컴퓨터공학', score: 88 },
    { id: 5, name: '똥개', major: '멀티미디어', score: 95 }
  ]);

  const [search, setSearch] = useState('');
  const [majorSearch, setMajorSearch] = useState(''); 
  const [scoreSearch, setScoreSearch] = useState('');
  
  // 2. 새로 추가할 학생 입력 폼 상태 정의
  const [form, setForm] = useState({
    name: '',
    major: '',
    score: '',
  });

  const { name, major, score } = form;
  const { theme } = useContext(ThemeContext);

  // 입력값 변경 핸들러
  const onChangeForm = (e) => {
    const { name, value } = e.target;
    setForm({
      ...form,
      [name]: value,
    });
  };

  // 학생 추가 핸들러
  const onAddStudent = (e) => {
    e.preventDefault();

    if (!name.trim() || !major.trim() || score === '') {
      alert('이름, 전공, 점수를 모두 입력해주세요!');
      return;
    }

    const newStudent = {
      id: Date.now(),
      name: name.trim(),
      major: major.trim(),
      score: Number(score),
    };

    setStudents([...students, newStudent]);
    
    // 입력 폼 초기화
    setForm({
      name: '',
      major: '',
      score: '',
    });
  };

  const filteredStudents = useMemo(() => {
    return students.filter((student) => {
      const matchesName = student.name.includes(search.trim());
      const matchesMajor = student.major.includes(majorSearch.trim());
      // 점수 검색 버그 수정 (student.major -> student.score)
      const matchesScore = student.score.toString().includes(scoreSearch.trim());

      return matchesName && matchesMajor && matchesScore;
    });
  }, [students, search, majorSearch, scoreSearch]);

  const averageScore = useMemo(() => {
    if (filteredStudents.length === 0) {
      return 0;
    }
    const total = filteredStudents.reduce((sum, student) => sum + student.score, 0);
    return Math.round(total / filteredStudents.length);
  }, [filteredStudents]);

  const clearSearch = useCallback(() => {
    setSearch('');
    setMajorSearch('');
    setScoreSearch('');
  }, []);

  return (
    <main className={theme === 'light' ? 'page light' : 'page dark'}>
      <Header />
      <section className="search-box">
        <label>학생 검색</label>
        
        <div className="search-row" style={{ display: 'flex', flexDirection: 'column', gap: '8px', marginBottom: '10px' }}>
          <input
            type="text"
            placeholder="학생 이름 입력"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
          />

          <input
            type="text"
            placeholder="학생 전공 입력"
            value={majorSearch}
            onChange={(e) => setMajorSearch(e.target.value)}
          />

          <input
            type="text"
            placeholder="학생 점수 입력"
            value={scoreSearch}
            onChange={(e) => setScoreSearch(e.target.value)}
          /> 
        </div>

        <button onClick={clearSearch}>검색 초기화</button>


        <p className="search-result" style={{ marginTop: '15px' }}>
          검색 결과 {filteredStudents.length}명 · 평균 점수 {averageScore}점
        </p>
      </section>

      <StudentList students={filteredStudents} />

      {}
      <footer style={{ textAlign: 'center', margin: '30px 0', padding: '10px' }}>
        <a 
          href="https://home.chungwoon.ac.kr/home/index.do" 
          target="_blank" 
          rel="noopener noreferrer"
          style={{ color: 'inherit', textDecoration: 'underline', fontSize: '13px' }}
        >
          개인정보 처리방침
        </a>
      </footer>
    </main>
  );
}

export default App;